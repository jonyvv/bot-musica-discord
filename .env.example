# --- Discord ---
# NO pongas el token aca en tu PC: guardalo cifrado con  .\scripts\dev.ps1 token
# (solo se usa esta variable en servidores, mejor con secretos de Docker: ver docs/05-despliegue-nube.md)
DISCORD_TOKEN=
# ID de tu servidor. Con el, los comandos aparecen al instante y el bot SOLO opera ahi.
DISCORD_GUILD_ID=
# Varios servidores permitidos, separados por comas. Vacio = usa DISCORD_GUILD_ID.
# Si ambos estan vacios el bot opera en cualquier servidor al que lo inviten (no recomendado).
ALLOWED_GUILD_IDS=

# --- Comunicacion bot -> resolver ---
RESOLVER_URL=http://127.0.0.1:8080
# Clave del bot: se genera con  .\scripts\dev.ps1 keygen  (queda cifrada, no se escribe aca).
RESOLVER_API_KEY=
# SHA-256 de esa clave: es lo unico que guarda el resolver. Lo escribe  keygen.
RESOLVER_API_KEY_SHA256=

# --- Limites contra abuso (segundos / cantidades) ---
IDLE_TIMEOUT=300
EMPTY_TIMEOUT=120
PAUSE_TIMEOUT=600
DEFAULT_VOLUME=50
MAX_QUEUE_SIZE=1000
MAX_TRACKS_PER_USER=200
MAX_INFLIGHT_REQUESTS=3
USER_COMMANDS_PER_10S=8
GUILD_COMMANDS_PER_10S=30
LOG_LEVEL=INFO

# --- Resolver ---
MAX_PLAYLIST_SIZE=500
# Maximo de duracion por cancion; las transmisiones en vivo siempre se rechazan. 0 = sin tope.
MAX_TRACK_SECONDS=10800
# Limites de la API (por cliente) y de tamano de cuerpo
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=300
# Consultas hacia YouTube: simultaneas, separacion minima y cortacircuito si nos marcan como bot
YTDLP_MAX_CONCURRENT=3
YTDLP_MIN_INTERVAL_SECONDS=0.3
YOUTUBE_BLOCK_THRESHOLD=3
YOUTUBE_BLOCK_COOLDOWN_SECONDS=600
CACHE_TTL_SECONDS=600
# Runtime de JavaScript que necesita yt-dlp: node (ya instalado en tu PC) o deno (Docker)
YTDLP_JS_RUNTIME=node
# Cliente de YouTube a usar, por ejemplo: tv,web_safari (vacio = el de por defecto)
YTDLP_PLAYER_CLIENT=
YTDLP_FORCE_IPV4=true
# Cookies de una cuenta DESCARTABLE de YouTube (nunca la personal). Vacio = sin cookies.
YOUTUBE_COOKIES_FILE=
# Solo para Docker: reinicia el resolver cuando sale una version nueva de yt-dlp
YTDLP_AUTO_UPDATE=false
