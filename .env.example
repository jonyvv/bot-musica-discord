# --- Discord (obligatorio) ---
# Token del bot: portal de desarrolladores > Bot > Reset Token. Nunca lo subas a git.
DISCORD_TOKEN=
# ID de tu servidor: con el, los comandos aparecen al instante (sin esto tardan en propagarse).
DISCORD_GUILD_ID=

# --- Bot ---
RESOLVER_URL=http://127.0.0.1:8080
# Segundos de espera antes de desconectarse (0 desactiva la regla)
IDLE_TIMEOUT=300
EMPTY_TIMEOUT=120
PAUSE_TIMEOUT=600
DEFAULT_VOLUME=50
MAX_QUEUE_SIZE=1000
LOG_LEVEL=INFO

# --- Resolver ---
MAX_PLAYLIST_SIZE=500
# Runtime de JavaScript que necesita yt-dlp: node (ya instalado en tu PC) o deno (Docker)
YTDLP_JS_RUNTIME=node
# Cliente de YouTube a usar, por ejemplo: tv,web_safari (vacio = el de por defecto)
YTDLP_PLAYER_CLIENT=
YTDLP_FORCE_IPV4=true
# Cookies de una cuenta DESCARTABLE de YouTube (nunca la personal). Vacio = sin cookies.
YOUTUBE_COOKIES_FILE=
# Solo para Docker: reinicia el resolver cuando sale una version nueva de yt-dlp
YTDLP_AUTO_UPDATE=false
